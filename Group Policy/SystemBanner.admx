<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="2.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="SystemBanner" namespace="SystemBanner.Policies.72EB5485_A763_4CAB_BA52_2E0209424149" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>
  <resources minRequiredRevision="2.0" />
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_NotSpecified" displayName="$(string.SystemBanner_SupportedOn)" />
    </definitions>
  </supportedOn>
  <categories>
    <category name="SystemBanner" displayName="$(string.Cat_SystemBanner)" />
  </categories>
  <policies>
    <!-- Australian PSPF classifications. Writes "Classification" (not upstream's "Simple") so upstream binaries cannot misread the numbers. -->
    <policy name="ConfigureClassificationBanner" class="Machine" displayName="$(string.Pol_Classification)" explainText="$(string.Pol_Classification_Help)" presentation="$(presentation.ConfigureClassificationBanner)" key="Software\Policies\SystemBanner">
      <parentCategory ref="SystemBanner" />
      <supportedOn ref="SUPPORTED_NotSpecified" />
      <elements>
        <enum id="ClassificationSetting" valueName="Classification" required="true">
          <item displayName="$(string.AU_Unofficial)">
            <value><decimal value="1" /></value>
            <!-- Also written outside \Policies so it persists (tattoos) when this policy becomes Not Configured/Disabled;
                 the banner then keeps this classification as a local value and the override menu unlocks. -->
            <valueList>
              <item key="Software\SystemBanner" valueName="ClassificationOverride"><value><decimal value="1" /></value></item>
              <item key="Software\SystemBanner" valueName="OverrideSetBy"><value><string>Group Policy (last enforced)</string></value></item>
              <item key="Software\SystemBanner" valueName="OverrideSetAt"><value><delete /></value></item>
            </valueList>
          </item>
          <item displayName="$(string.AU_Official)">
            <value><decimal value="2" /></value>
            <!-- Also written outside \Policies so it persists (tattoos) when this policy becomes Not Configured/Disabled;
                 the banner then keeps this classification as a local value and the override menu unlocks. -->
            <valueList>
              <item key="Software\SystemBanner" valueName="ClassificationOverride"><value><decimal value="2" /></value></item>
              <item key="Software\SystemBanner" valueName="OverrideSetBy"><value><string>Group Policy (last enforced)</string></value></item>
              <item key="Software\SystemBanner" valueName="OverrideSetAt"><value><delete /></value></item>
            </valueList>
          </item>
          <item displayName="$(string.AU_OfficialSensitive)">
            <value><decimal value="3" /></value>
            <!-- Also written outside \Policies so it persists (tattoos) when this policy becomes Not Configured/Disabled;
                 the banner then keeps this classification as a local value and the override menu unlocks. -->
            <valueList>
              <item key="Software\SystemBanner" valueName="ClassificationOverride"><value><decimal value="3" /></value></item>
              <item key="Software\SystemBanner" valueName="OverrideSetBy"><value><string>Group Policy (last enforced)</string></value></item>
              <item key="Software\SystemBanner" valueName="OverrideSetAt"><value><delete /></value></item>
            </valueList>
          </item>
          <item displayName="$(string.AU_Protected)">
            <value><decimal value="4" /></value>
            <!-- Also written outside \Policies so it persists (tattoos) when this policy becomes Not Configured/Disabled;
                 the banner then keeps this classification as a local value and the override menu unlocks. -->
            <valueList>
              <item key="Software\SystemBanner" valueName="ClassificationOverride"><value><decimal value="4" /></value></item>
              <item key="Software\SystemBanner" valueName="OverrideSetBy"><value><string>Group Policy (last enforced)</string></value></item>
              <item key="Software\SystemBanner" valueName="OverrideSetAt"><value><delete /></value></item>
            </valueList>
          </item>
          <item displayName="$(string.AU_Secret)">
            <value><decimal value="5" /></value>
            <!-- Also written outside \Policies so it persists (tattoos) when this policy becomes Not Configured/Disabled;
                 the banner then keeps this classification as a local value and the override menu unlocks. -->
            <valueList>
              <item key="Software\SystemBanner" valueName="ClassificationOverride"><value><decimal value="5" /></value></item>
              <item key="Software\SystemBanner" valueName="OverrideSetBy"><value><string>Group Policy (last enforced)</string></value></item>
              <item key="Software\SystemBanner" valueName="OverrideSetAt"><value><delete /></value></item>
            </valueList>
          </item>
          <item displayName="$(string.AU_TopSecret)">
            <value><decimal value="6" /></value>
            <!-- Also written outside \Policies so it persists (tattoos) when this policy becomes Not Configured/Disabled;
                 the banner then keeps this classification as a local value and the override menu unlocks. -->
            <valueList>
              <item key="Software\SystemBanner" valueName="ClassificationOverride"><value><decimal value="6" /></value></item>
              <item key="Software\SystemBanner" valueName="OverrideSetBy"><value><string>Group Policy (last enforced)</string></value></item>
              <item key="Software\SystemBanner" valueName="OverrideSetAt"><value><delete /></value></item>
            </valueList>
          </item>
        </enum>
      </elements>
    </policy>
    <policy name="SetBannerPositionSetting" class="Machine" displayName="$(string.Pol_Position)" explainText="$(string.Pol_Position_Help)" presentation="$(presentation.SetBannerPositionSetting)" key="Software\Policies\SystemBanner">
      <parentCategory ref="SystemBanner" />
      <supportedOn ref="SUPPORTED_NotSpecified" />
      <elements>
        <enum id="BannerPositionSetting" valueName="BannerPosition" required="true">
          <item displayName="$(string.Pos_TopOnly)"><value><decimal value="0" /></value></item>
          <item displayName="$(string.Pos_TopAndBottom)"><value><decimal value="1" /></value></item>
        </enum>
      </elements>
    </policy>
    <policy name="SetFullscreenHide" class="Machine" displayName="$(string.Pol_FullscreenHide)" explainText="$(string.Pol_FullscreenHide_Help)" key="Software\Policies\SystemBanner" valueName="FullscreenHide">
      <parentCategory ref="SystemBanner" />
      <supportedOn ref="SUPPORTED_NotSpecified" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="SetOverrideGroups" class="Machine" displayName="$(string.Pol_OverrideGroups)" explainText="$(string.Pol_OverrideGroups_Help)" presentation="$(presentation.SetOverrideGroups)" key="Software\Policies\SystemBanner" valueName="OverrideEnabled">
      <parentCategory ref="SystemBanner" />
      <supportedOn ref="SUPPORTED_NotSpecified" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
      <elements>
        <text id="OverrideGroupsText" valueName="OverrideGroups" required="true" maxLength="1023" />
      </elements>
    </policy>
  </policies>
</policyDefinitions>
